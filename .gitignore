# Scratch output of every design (renders, cams.json, the web GLB, overlays, trial blends, old versions pulled
# with tools/get_version.py). Keepers are copied out by tools/publish.py: model/ and renders/ are committed.
designs/*/build/

# Blender's automatic backups ("Save Versions" preference): git already keeps every version
*.blend1
*.blend2

# Python caches
__pycache__/
*.pyc

# npm installs for the viewer bundle (make viewer)
node_modules/
package.json
package-lock.json
